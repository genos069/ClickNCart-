NODE_ENV=development
PORT=3000
# MongoDB must be a replica set (Atlas supports transactions).
MONGO_URI=mongodb://127.0.0.1:27017/clickncart?replicaSet=rs0
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CLIENT_URL=http://localhost:5173
# Set only for a known reverse-proxy topology, e.g. one trusted hop.
# TRUST_PROXY=1
EMAIL_USER=
EMAIL_PASS=
# Optional external services, disabled when absent. Do not reuse the exposed key.
AI_DISCOUNT_URL=
AI_API_KEY=
REVIEW_ML_URL=
